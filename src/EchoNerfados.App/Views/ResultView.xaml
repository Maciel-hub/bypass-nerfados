<UserControl x:Class="EchoNerfados.App.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EchoNerfados.App.ViewModels"
             Background="{StaticResource BackgroundBrush}">

  <ScrollViewer Style="{StaticResource MinimalScrollViewerStyle}">
    <StackPanel Margin="32,24" MaxWidth="680" HorizontalAlignment="Left">

      <!-- ── SCORE CARD ──────────────────────────────────────────────────── -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Score number -->
          <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Score}"
                       Style="{StaticResource ScoreNumberStyle}"
                       Foreground="{Binding RiskBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="/100"
                       Style="{StaticResource SecondaryTextStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,-8,0,0" />
          </StackPanel>

          <!-- Risk label + breakdown -->
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding RiskLabel}"
                       Style="{StaticResource ScoreLabelStyle}"
                       Foreground="{Binding RiskBrush}"
                       Margin="0,0,0,12" />

            <!-- Severity grid -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding CriticalCount}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource CriticalBrush}" />
                <TextBlock Text="CRITICAL" Style="{StaticResource SecondaryTextStyle}" FontSize="10" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding HighCount}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource HighBrush}" />
                <TextBlock Text="HIGH" Style="{StaticResource SecondaryTextStyle}" FontSize="10" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding MediumCount}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource MediumBrush}" />
                <TextBlock Text="MEDIUM" Style="{StaticResource SecondaryTextStyle}" FontSize="10" />
              </StackPanel>
              <StackPanel Grid.Column="3">
                <TextBlock Text="{Binding LowCount}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource LowBrush}" />
                <TextBlock Text="LOW" Style="{StaticResource SecondaryTextStyle}" FontSize="10" />
              </StackPanel>
            </Grid>

            <Rectangle Style="{StaticResource SeparatorStyle}" Margin="0,12,0,6" />

            <!-- Scan meta -->
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} findings  ·  {1} módulos  ·  {2} min">
                    <Binding Path="TotalFindings" />
                    <Binding Path="ModulesRun" />
                    <Binding Path="ScanDuration" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── TOP FINDINGS ───────────────────────────────────────────────── -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="TOP INDÍCIOS (High / Critical)"
                     Style="{StaticResource SectionTitleStyle}"
                     Margin="0,0,0,12" />

          <ItemsControl ItemsSource="{Binding TopFindings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:FindingViewModel}">
                <Border Margin="0,0,0,6" Padding="10,8"
                        Background="#FF1E1E1E" CornerRadius="3"
                        BorderBrush="{Binding RiskBrush}" BorderThickness="2,0,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Badge -->
                    <Border Grid.Column="0"
                            Background="{Binding RiskBrush}"
                            CornerRadius="2" Padding="6,2" Margin="0,0,10,0"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding RiskLabel}"
                                 FontSize="10" FontWeight="Bold"
                                 Foreground="White" />
                    </Border>

                    <!-- Title + evidence -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}"
                                 Style="{StaticResource BaseTextStyle}"
                                 TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Evidence}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 FontFamily="Consolas" FontSize="10"
                                 TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Module name -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding Module}"
                               Style="{StaticResource SecondaryTextStyle}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="(sem indícios High ou Critical)" Margin="0,4,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding TopFindings.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- ── ACTION BUTTONS ─────────────────────────────────────────────── -->
      <StackPanel Orientation="Horizontal">
        <Button Content="Abrir HTML"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding OpenHtmlReportCommand}"
                IsEnabled="{Binding HasReport}"
                Margin="0,0,10,0" />
        <Button Content="Relatório Executivo"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding OpenExecutiveReportCommand}"
                IsEnabled="{Binding HasReport}"
                Margin="0,0,10,0" />
        <Button Content="Abrir Pasta"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding OpenReportFolderCommand}"
                IsEnabled="{Binding HasReport}"
                Margin="0,0,10,0" />
        <Button Content="Nova Varredura"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding NewScanCommand}" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
