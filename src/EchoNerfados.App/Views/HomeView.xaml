<UserControl x:Class="EchoNerfados.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EchoNerfados.App.Converters"
             Background="{StaticResource BackgroundBrush}">

  <UserControl.Resources>
    <conv:BoolToLicenseStatusConverter x:Key="LicStatusConv" />
    <conv:BoolToLicenseColorConverter  x:Key="LicColorConv" />
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource MinimalScrollViewerStyle}">
    <StackPanel Margin="32,24" MaxWidth="680" HorizontalAlignment="Left">

      <!-- ── LICENSE CARD ─────────────────────────────────────────────── -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Section title -->
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                     Text="LICENÇA"
                     Style="{StaticResource SectionTitleStyle}" />

          <!-- Status badge -->
          <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border CornerRadius="3" Padding="8,3" Margin="0,0,12,0"
                    Background="{Binding LicenseValid, Converter={StaticResource LicColorConv}}">
              <TextBlock Text="{Binding LicenseValid, Converter={StaticResource LicStatusConv}}"
                         Foreground="White" FontSize="11" FontWeight="Bold" />
            </Border>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
              <TextBlock Text="{Binding LicenseCustomer}" Style="{StaticResource BaseTextStyle}" />
              <TextBlock Text="{Binding LicenseStatus}"   Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
          </StackPanel>

          <!-- Machine ID -->
          <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Machine ID: " Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding MachineId}"
                       Style="{StaticResource BaseTextStyle}"
                       FontFamily="Consolas"
                       Margin="6,0,12,0" />
            <Button Content="Copiar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,4"
                    FontSize="11"
                    Command="{Binding CopyMachineIdCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── CONFIGURATION CARD ───────────────────────────────────────── -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="CONFIGURAÇÃO DA VARREDURA"
                     Style="{StaticResource SectionTitleStyle}"
                     Margin="0,0,0,14" />

          <!-- Investigator -->
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Investigador"
                       Style="{StaticResource FieldLabelStyle}" />
            <TextBox Grid.Column="1"
                     Text="{Binding InvestigatorName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DarkTextBoxStyle}" />
          </Grid>

          <!-- Suspect -->
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Suspeito"
                       Style="{StaticResource FieldLabelStyle}" />
            <TextBox Grid.Column="1"
                     Text="{Binding SuspectName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DarkTextBoxStyle}" />
          </Grid>

          <!-- Case ID -->
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ID do Caso"
                       Style="{StaticResource FieldLabelStyle}" />
            <TextBox Grid.Column="1"
                     Text="{Binding CaseId, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DarkTextBoxStyle}" />
          </Grid>

          <Rectangle Style="{StaticResource SeparatorStyle}" />

          <!-- Profile selector -->
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Perfil"
                       Style="{StaticResource FieldLabelStyle}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile}"
                      Style="{StaticResource DarkComboBoxStyle}"
                      DisplayMemberPath="Label" />
          </Grid>

          <!-- Profile description -->
          <TextBlock Text="{Binding SelectedProfile.Description}"
                     Style="{StaticResource SecondaryTextStyle}"
                     Margin="130,0,0,10" />

          <!-- Output folder -->
          <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Saída"
                       Style="{StaticResource FieldLabelStyle}" />
            <TextBox Grid.Column="1"
                     Text="{Binding ReportOutputPath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Margin="0,0,8,0" />
            <Button Grid.Column="2"
                    Content="Procurar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding BrowseOutputFolderCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ── START BUTTON ─────────────────────────────────────────────── -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="Execute como Administrador para acesso completo aos módulos de memória e USN Journal."
                   Style="{StaticResource SecondaryTextStyle}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />

        <Button Grid.Column="1"
                Content="▶  INICIAR VARREDURA"
                Style="{StaticResource PrimaryButtonStyle}"
                FontSize="14"
                Padding="24,12"
                Margin="16,0,0,0"
                Command="{Binding StartScanCommand}" />
      </Grid>

    </StackPanel>
  </ScrollViewer>
</UserControl>
