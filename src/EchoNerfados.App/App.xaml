<Application x:Class="EchoNerfados.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EchoNerfados.App.ViewModels"
             xmlns:views="clr-namespace:EchoNerfados.App.Views"
             ShutdownMode="OnMainWindowClose">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Colors.xaml" />
        <ResourceDictionary Source="Resources/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- DataTemplates: ViewModel → View mapping -->
      <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <views:HomeView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ScanViewModel}">
        <views:ScanView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ResultViewModel}">
        <views:ResultView />
      </DataTemplate>

    </ResourceDictionary>
  </Application.Resources>

</Application>
