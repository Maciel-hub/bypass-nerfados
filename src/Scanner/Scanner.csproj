<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>BypassNerfados</AssemblyName>
    <RootNamespace>BypassNerfados.Scanner</RootNamespace>
    <AssemblyTitle>Bypass Nerfados Shield XDR</AssemblyTitle>
    <Product>Bypass Nerfados Shield XDR</Product>
    <Description>Plataforma forense anti-cheat para investigação de screen-share</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

</Project>
