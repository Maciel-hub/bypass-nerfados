<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>EchoNerfados</AssemblyName>
    <RootNamespace>BypassNerfados.Scanner</RootNamespace>
    <AssemblyTitle>Echo Nerfados Shield XDR</AssemblyTitle>
    <Product>Echo Nerfados Shield XDR</Product>
    <Description>Plataforma forense anti-cheat para investigação de screen-share</Description>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    Console host keeps only: Program.cs, Core/ConsoleUI.cs, Core/LiveDashboard.cs.
    Everything else is compiled in Scanner.Core and referenced via ProjectReference.
  -->
  <ItemGroup>
    <Compile Remove="Core\Correlator.cs" />
    <Compile Remove="Core\EvidenceEnricher.cs" />
    <Compile Remove="Core\FindingDeduplicator.cs" />
    <Compile Remove="Core\LicenseValidator.cs" />
    <Compile Remove="Core\RulesLoader.cs" />
    <Compile Remove="Core\ScanConfig.cs" />
    <Compile Remove="Core\ScanOrchestrator.cs" />
    <Compile Remove="Core\ScanProgressUpdate.cs" />
    <Compile Remove="Data\**" />
    <Compile Remove="Models\**" />
    <Compile Remove="Modules\**" />
    <Compile Remove="Reports\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scanner.Core\Scanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only Spectre.Console stays here; all other NuGet deps live in Scanner.Core -->
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- rules\ is already included via Scanner.Core Content items (CopyToOutputDirectory) -->
    <!-- Keep this entry for the publish profile which copies from the Scanner project tree -->
    <Content Include="rules\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Embed git commit hash in InformationalVersion at build time -->
  <Target Name="SetGitVersion" BeforeTargets="CoreCompile;GetAssemblyVersion">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitShortHash" />
    </Exec>
    <PropertyGroup>
      <GitShortHash>$(GitShortHash.Trim())</GitShortHash>
      <InformationalVersion Condition="'$(GitShortHash)' != ''">$(Version)+$(GitShortHash)</InformationalVersion>
      <InformationalVersion Condition="'$(GitShortHash)' == ''">$(Version)+unknown</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
