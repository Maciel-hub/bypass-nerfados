<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>EchoHarness</AssemblyName>
    <RootNamespace>BypassNerfados.MemoryHarness</RootNamespace>
    <AssemblyTitle>Echo Nerfados — Memory Harness (Positive-Control)</AssemblyTitle>
    <Product>EchoMemoryHarness</Product>
    <Description>Positive-control harness for MemoryDllTraceModule QA. Simulates manual map, shellcode thread, and deleted-DLL-in-memory scenarios.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
